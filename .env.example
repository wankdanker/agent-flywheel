# For local `docker run --env-file .env agent-flywheel`. In CI these come from the platform.
# docker --env-file doesn't strip inline comments, so ours live on their own lines.

# --- Required ---
# One of these two (the OAuth one comes from `claude setup-token`)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# github or gitlab
AGENT_PLATFORM=
# Issue number (GitHub) or IID (GitLab) to work
ISSUE=

# --- GitHub ---
# Token with contents, issues, and pull-requests write access
GH_TOKEN=
# owner/repo
GITHUB_REPOSITORY=

# --- GitLab ---
# Project access token: api + write_repository, Developer role
AGENT_GITLAB_TOKEN=
CI_SERVER_HOST=gitlab.com
# group/project
CI_PROJECT_PATH=

# --- Optional ---
CLAUDE_MODEL=
MAX_TURNS=80
# Comma-separated owner/repo (GitHub) or group/project (GitLab) the agent may clone or
# push to. Defaults to just GITHUB_REPOSITORY/CI_PROJECT_PATH; only widen this if you
# really mean to let one run touch more than one repo.
AGENT_REPO_ALLOWLIST=
GIT_AUTHOR_NAME=Agent Flywheel
GIT_AUTHOR_EMAIL=
# Where repos get cloned, under a per-issue subdirectory. Defaults to /work (the image's
# baked-in scratch dir). CI mounts a cache here so a run that dies partway can resume.
WORK_DIR=
