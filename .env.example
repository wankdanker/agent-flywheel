# For local `docker run --env-file .env agent-flywheel`. In CI these come from the platform.
# docker --env-file doesn't strip inline comments, so ours live on their own lines.

# --- Required ---
# One of these two (the OAuth one comes from `claude setup-token`)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# github, gitlab or notion
AGENT_PLATFORM=
# Issue number (GitHub) or IID (GitLab) to work. Notion uses NOTION_TICKET_ID instead.
ISSUE=

# --- GitHub ---
# Token with contents, issues, and pull-requests write access
GH_TOKEN=
# owner/repo
GITHUB_REPOSITORY=

# --- GitLab ---
# Project access token: api + write_repository, Developer role
AGENT_GITLAB_TOKEN=
CI_SERVER_HOST=gitlab.com
# group/project
CI_PROJECT_PATH=

# --- Notion ---
# Internal integration token, shared with the tickets database
NOTION_TOKEN=
# The specific page to work (AGENT_PLATFORM=notion runs one ticket, like GitHub/GitLab).
# bin/list-notion-tickets.ts finds candidates for you instead of setting this by hand.
NOTION_TICKET_ID=
# Needed only by bin/list-notion-tickets.ts (the poller), not by a single ticket run:
NOTION_DATABASE_ID=
# The bot's value in the "assigned to" property (a Notion person id, or a select/status name)
NOTION_ASSIGNEE_VALUE=
# Property name guesses below aren't confirmed against a real database yet — see the
# `notion-ticket` skill. Override any of these once the actual schema is known.
NOTION_ASSIGNEE_PROPERTY=Assignee
NOTION_READY_PROPERTY=Status
NOTION_READY_VALUE=Ready
NOTION_REPO_PROPERTY=Repo
NOTION_STATUS_PROPERTY=Status
# "status" (Notion's Status property type) or "select"
NOTION_STATUS_PROPERTY_TYPE=status
NOTION_STATUS_WORKING=agent/working
NOTION_STATUS_BLOCKED=agent/blocked
NOTION_STATUS_REVIEW=agent/review

# --- Optional ---
CLAUDE_MODEL=
MAX_TURNS=80
GIT_AUTHOR_NAME=Agent Flywheel
GIT_AUTHOR_EMAIL=
# Where repos get cloned, under a per-issue subdirectory. Defaults to /work (the image's
# baked-in scratch dir). CI mounts a cache here so a run that dies partway can resume.
WORK_DIR=
