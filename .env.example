# For local `docker run --env-file .env agent-flywheel`. In CI these come from the platform.
# docker --env-file doesn't strip inline comments, so ours live on their own lines.

# --- Required ---
# One of these two (the OAuth one comes from `claude setup-token`)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# github or gitlab
AGENT_PLATFORM=
# Issue number (GitHub) or IID (GitLab) to work
ISSUE=

# --- GitHub ---
# Token with contents, issues, and pull-requests write access
GH_TOKEN=
# owner/repo
GITHUB_REPOSITORY=
# Optional: the numeric user id (preferred) and/or login of the account GH_TOKEN posts as.
# Unset, it's asked from GitHub (GraphQL viewer). Only marked comments from this exact
# account, or from a trusted association, count as the agent's own.
AGENT_BOT_ID=
AGENT_BOT_LOGIN=

# --- GitLab ---
# Project access token: api + write_repository, Developer role
AGENT_GITLAB_TOKEN=
CI_SERVER_HOST=gitlab.com
# group/project
CI_PROJECT_PATH=

# --- Optional ---
CLAUDE_MODEL=
# Model for `--smoke` (the image smoke test); defaults to CLAUDE_MODEL. A cheap one is fine.
SMOKE_MODEL=
# Model turns per run: an integer from 1 to 500 (default 120). Anything else fails config
# validation before the issue is touched.
MAX_TURNS=80
# Per-run spend cap in US dollars (the SDK's maxBudgetUsd), e.g. 5 or 2.50. Unset: no cap
# beyond MAX_TURNS. Hitting it settles as a checkpoint (or blocked, if nothing was committed).
MAX_BUDGET_USD=
# CI only: how many times in a row a checkpoint relays itself to a new run before a
# maintainer has to comment (default 3, 0 = never). A local run never relays.
MAX_CHAINED_RUNS=
# Comma-separated owner/repo (GitHub) or group/project (GitLab) the agent may clone or
# push to. Defaults to just GITHUB_REPOSITORY/CI_PROJECT_PATH; only widen this if you
# really mean to let one run touch more than one repo. Every repo an issue's `Target:`
# header names must be listed, and so must the hub itself once this is set (README's
# "Cross-repo work"). Patterns: owner/* (any repo directly under owner), group/** (any
# depth), owner/prefix-* (within one segment); the first segment must be literal. A
# pattern also allows repos created there later. See README's "Repository allowlist".
AGENT_REPO_ALLOWLIST=
GIT_AUTHOR_NAME=Agent Flywheel
GIT_AUTHOR_EMAIL=
# Where repos get cloned, under a per-issue subdirectory. Defaults to /work (the image's
# baked-in scratch dir). CI mounts a cache here so a run that dies partway can resume.
WORK_DIR=

# --- Model credential proxy (src/model-proxy.ts) ---
# The real API key/token never reaches the agent subprocess; see README "Model
# credential exposure". Defaults (2000 requests, 2h lifetime, 120s per request) are
# usually fine to leave unset.
MODEL_PROXY_MAX_REQUESTS=
MODEL_PROXY_MAX_LIFETIME_MS=
MODEL_PROXY_REQUEST_TIMEOUT_MS=
